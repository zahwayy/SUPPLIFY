# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Connection
# Update username, password, host, port, and database name for your local PostgreSQL instance
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE_NAME

# Session Configuration
# Generate a random secret (at least 32 chars) for local development
SESSION_SECRET=replace_with_a_random_32_char_secret_string
SESSION_TTL_DAYS=7

# Local File Storage (outside public/ so sensitive evidence is never served directly)
STORAGE_ROOT=./storage/uploads
MAX_UPLOAD_SIZE_MB=5
